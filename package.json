{
  "name": "anato-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000 --webpack",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build --webpack",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "tsx --test tests/core.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "optimize:models": "node scripts/optimize-models.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@types/three": "^0.182.0",
    "framer-motion": "^12.23.26",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "openai": "^6.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
